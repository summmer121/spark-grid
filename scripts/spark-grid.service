# Reference template. Use scripts/install_service.sh to generate the active unit.
[Unit]
Description=Spark Grid monitoring center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory="@SPARK_ROOT@"
EnvironmentFile=-"@SPARK_ENV_FILE@"
ExecStart="@SPARK_PYTHON@" -m app.main
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
