[Unit]
Description=Spark Grid monitoring center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/spark-monitor
EnvironmentFile=-%h/spark-monitor/.env
ExecStart=/usr/bin/python3 -m app.main
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
