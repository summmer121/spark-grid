SPARK_MONITOR_HOST=0.0.0.0
SPARK_MONITOR_PORT=6301
SPARK_MONITOR_DATA=./data
# Optional SQLite path. Relative paths are resolved from the project root.
SPARK_DATABASE_PATH=
# SQLite lock wait in seconds. Can also be changed from the settings page.
SPARK_DATABASE_TIMEOUT=15
SPARK_LOG_LEVEL=INFO

# SSH pull settings for the center node. Blank uses the service account.
SPARK_SSH_USER=
SPARK_SSH_PORT=22
SPARK_SSH_KEY_PATH=
SPARK_SSH_BIN=ssh
# Optional known_hosts path. Relative paths are resolved from the project root.
SPARK_SSH_KNOWN_HOSTS_PATH=
SPARK_SSH_TIMEOUT=8
SPARK_SSH_CONNECT_TIMEOUT=8
SPARK_SSH_CONTROL_PERSIST=90
SPARK_SSH_STRICT_HOST_KEY_CHECKING=accept-new
# Remote read-only script timeouts in seconds.
SPARK_SSH_INTERFACE_QUERY_TIMEOUT=3
SPARK_SSH_GPU_INFO_TIMEOUT=3
SPARK_SSH_GPU_METRICS_TIMEOUT=4
SPARK_SSH_CPU_SAMPLE_INTERVAL=0.5
# Arguments are allowed, for example: /usr/bin/python3 -u
SPARK_REMOTE_PYTHON=python3
SPARK_HOSTS=
# Fernet key path. Relative paths are resolved from the project root.
SPARK_CREDENTIAL_KEY_FILE=

SPARK_POLL_INTERVAL=3
SPARK_DISCOVERY_INTERVAL=600
SPARK_SESSION_TTL_HOURS=12
SPARK_COOKIE_SECURE=0
SPARK_HISTORY_RETENTION_HOURS=24
SPARK_MODEL_PORTS=8888,8000,8001,30000
SPARK_MODEL_CONTAINERS=
# Arguments are allowed, for example: sudo -n docker
SPARK_MODEL_CONTAINER_RUNTIME=docker
SPARK_MODEL_SCHEME=http
SPARK_MODEL_HEALTH_PATH=/health
SPARK_MODEL_METRICS_PATH=/metrics
SPARK_NETWORK_INTERFACE_EXCLUDE_PREFIXES=lo,docker,veth,br-,virbr
# Optional reachable address used by remote nodes to select their management NIC.
# Leave blank to prefer the address of the current SSH connection.
SPARK_NETWORK_ROUTE_PROBE_HOST=
# Leave blank to disable GPU collection.
SPARK_GPU_QUERY_COMMAND=nvidia-smi
SPARK_GPU_POWER_ESTIMATE=0
SPARK_GPU_POWER_ESTIMATE_NAMES=
SPARK_GPU_POWER_ESTIMATE_IDLE_WATTS=0
SPARK_GPU_POWER_ESTIMATE_RATED_WATTS=0
# Blank auto-detects the service account's system timezone.
SPARK_SYSTEM_TIMEZONE=
SPARK_UI_TIMEZONE=
SPARK_MODEL_TIMEZONE=

# Foreground launcher and service installer.
SPARK_PYTHON=python3
SPARK_PID_FILE=.server.pid
SPARK_LOG_FILE=.server.log
SPARK_HEALTH_URL=
SPARK_HEALTH_HOST=
SPARK_HEALTH_PATH=/api/health
SPARK_HEALTH_TIMEOUT=2
SPARK_STARTUP_TIMEOUT=15
SPARK_STOP_TIMEOUT=10
SPARK_UNIT_NAME=spark-grid
SPARK_SYSTEM_SERVICE_NAME=spark-grid

# Optional TLS reverse proxy. tls_proxy.py reads the same variables.
SPARK_TLS_LISTEN=0.0.0.0
SPARK_TLS_PORT=30001
SPARK_TLS_TARGET=127.0.0.1:16301
SPARK_TLS_CERT=
SPARK_TLS_KEY=
SPARK_TLS_CONNECT_TIMEOUT=5
SPARK_TLS_POLL_TIMEOUT=30
