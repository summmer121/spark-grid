[Unit]
Description=Spark Grid SSH tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SPARK_SERVICE_USER@
Group=@SPARK_SERVICE_GROUP@
Environment=HOME="@SPARK_SERVICE_HOME@"
EnvironmentFile=-"@SPARK_TUNNEL_ENV_FILE@"
ExecStart="@SPARK_SSH_BIN@" -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=${SPARK_TUNNEL_ALIVE_INTERVAL} -o ServerAliveCountMax=${SPARK_TUNNEL_ALIVE_COUNT} -o StrictHostKeyChecking=${SPARK_TUNNEL_HOST_KEY_CHECKING} -i "${SPARK_TUNNEL_KEY}" -p ${SPARK_TUNNEL_PORT} -L ${SPARK_TUNNEL_BIND}:${SPARK_TUNNEL_LOCAL_PORT}:${SPARK_TUNNEL_TARGET_HOST}:${SPARK_TUNNEL_TARGET_PORT} ${SPARK_TUNNEL_USER}@${SPARK_TUNNEL_HOST}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
