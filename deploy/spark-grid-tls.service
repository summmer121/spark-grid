[Unit]
Description=Spark Grid public TLS gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SPARK_SERVICE_USER@
Group=@SPARK_SERVICE_GROUP@
Environment=HOME="@SPARK_SERVICE_HOME@"
EnvironmentFile=-"@SPARK_TLS_ENV_FILE@"
ExecStart="@SPARK_PYTHON@" "@SPARK_TLS_PROXY@"
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
