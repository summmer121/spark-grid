[Unit]
Description=Spark Grid monitoring center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SPARK_SERVICE_USER@
Group=@SPARK_SERVICE_GROUP@
Environment=HOME="@SPARK_SERVICE_HOME@"
WorkingDirectory="@SPARK_ROOT@"
EnvironmentFile=-"@SPARK_ENV_FILE@"
ExecStart="@SPARK_PYTHON@" -m app.main
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=@SPARK_READ_WRITE_PATHS@

[Install]
WantedBy=multi-user.target
